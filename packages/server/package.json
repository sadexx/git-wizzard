{
  "name": "@git-assistant/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "imports": {
    "#*": "./dist/*"
  },
  "scripts": {
