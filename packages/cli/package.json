{
  "name": "@git-wizzard/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "bin": {
    "gitwizz": "./dist/index.js"
  },
  "imports": {
    "#*": "./dist/*"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@git-wizzard/server": "*",
    "@git-wizzard/shared": "*",
    "@google/genai": "^2.10.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^15.0.0",
    "ink": "^7.1.0",
    "openai": "^6.45.0",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.18"
  }
}
